@model IEnumerable<MyShop.Models.Item>

<!DOCTYPE html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.3/css/bootstrap.min.css">
    <title>My Shop</title>
</head>
<body>
    <div class="container">
        <h1>@ViewBag.CurrentViewName</h1>
        <table class="table table-striped">
            <tr><th>Id</th> <th>Name</th> <th>Price</th> <th>Description</th></tr>
            @foreach (var item in Model) // for each item in Model...
            {
                <tr> // ...it creates a new row and assigns its values
                    <td>@item.ItemId</td>
                    <td>@item.Name</td>
                    <td>@item.Price.ToString("0.00 NOK")</td>
                    <td>@item.Description</td>
                </tr>
            }
        </table>
    </div>
</body>
</html>